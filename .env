# MongoDB connection URI
MONGO_URI=mongodb://mongo:27017/jobs_db

# Queue broker URL (e.g. RabbitMQ, Redis, Kafka)
# RabbitMQ: amqp://user:pass@rabbitmq:5672
QUEUE_URL=

# Secret for vendor‑webhook signature verification
VENDOR_WEBHOOK_SECRET=your_shared_secret_here

# Any other secrets you’ll need
